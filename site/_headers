# Cabeçalhos de segurança e cache (Netlify e Cloudflare Pages leem este arquivo automaticamente).
# Se mudar o serviço de formulário ou a planilha, confira a linha connect-src.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://formspree.io https://script.google.com https://script.googleusercontent.com https://docs.google.com https://*.googleusercontent.com; form-action 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'

# Páginas e configuração: o navegador sempre confere se há versão nova.
/
  Cache-Control: no-cache
/*.html
  Cache-Control: no-cache
/dados.js
  Cache-Control: no-cache

# Fonte e imagens mudam raramente.
/fontes/*
  Cache-Control: public, max-age=31536000, immutable
/og.jpg
  Cache-Control: public, max-age=86400
